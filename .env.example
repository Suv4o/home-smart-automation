# Local config. Run with:  node --env-file=.env src/cli.ts <command>

# --- Solarman ---
# Seed the refresh token once from a logged-in browser (see docs/authentication.md):
#   node --env-file=.env src/cli.ts seed <refresh-token>
SOLARMAN_STATION_ID=
# Password login is blocked by Cloudflare Turnstile, so these stay unset and the
# refresh-token flow above is used instead. Listed only for completeness.
# SOLARMAN_EMAIL=
# SOLARMAN_PASSWORD=

# --- Tapo P110 (LOCAL control over the LAN) ---
# Use the SAME credentials that work in your tapo-smart-plug repo (the TP-Link
# account the plug is registered to). Read directly by scripts/plug_local.py.
# If TAPO_HOST becomes unreachable (e.g. DHCP moved it after a power cut), the
# script scans the LAN and finds the plug by name automatically — a DHCP
# reservation in your router avoids the scan. Find the current IP any time with:
#   uv run --script scripts/plug_local.py discover
TAPO_HOST=
TAPO_USERNAME=
TAPO_PASSWORD=
# Command that runs the local plug CLI. uv reads the script's inline deps and
# fetches python-kasa itself — no venv needed. (Install uv: brew install uv.)
PLUG_CLI_CMD=uv run --script scripts/plug_local.py
# Only needed for the LAN-scan fallback if you have more than one Tapo/Kasa device:
# TAPO_ALIAS=Tapo P110

# --- Charging policy (Melbourne local time) ---
MORNING_START=05:00      # start of the morning battery-share window
FREE_START=10:00         # start of the free-power window (always charge)
FREE_END=14:00           # end of free power; after this the solar rule applies
BATTERY_START_PCT=40     # start a morning session only if battery is above this
BATTERY_STOP_PCT=15      # stop the morning session at/below this
SOLAR_COVER_RATIO=0.70   # after 2pm: charge if solar >= ratio*(house + car)
# After 2pm, WHILE THE SUN IS UP: if the house battery is above this, charge
# regardless of the solar test (battery full ⇒ send the surplus to the car).
BATTERY_BYPASS_PCT=80
CAR_POWER_W=2000         # nominal charger draw (10A Tesla mobile ~2-2.4kW)
# Main-switch protection: never charge if (grid import + car) would exceed this.
# Main breaker is 50A (~11.5kW); 10kW leaves a safety margin.
MAIN_SWITCH_LIMIT_W=10000

# --- Car battery (Tesla, read over Bluetooth via tesla-control) ---
# A START gate, not a ceiling. Automatic charging begins only when the car is at
# or below this. Once a session is running it charges all the way to the car's
# own charge limit (set in the Tesla app), and a manual "charge now" ignores this
# figure entirely. So at 70% the car starts and fills to its limit; at 90% the
# schedule leaves it alone.
CAR_START_MAX_SOC=80
# How long to trust one car reading before waking the car again (minutes).
# Reads wake the car, so keep this generous; ticks in between reuse the value.
CAR_SOC_TTL_MINUTES=60
# The same, but while the car is actually drawing power. A charging car is
# already awake, so a read costs no wake and the percentage can stay fresh.
# Lower it for a livelier number; each read is a BLE round-trip of a few seconds.
CAR_SOC_TTL_CHARGING_MINUTES=5
# Below this draw, the plug is live but nothing is charging (no cable in the
# car). The mobile connector pulls ~2kW; an idle socket only a few watts.
CAR_DRAW_MIN_W=500
# tesla-control binary (on PATH, or an absolute path).
TESLA_CONTROL_CMD=tesla-control
# tesla-control reads these itself. The launchd daemon does NOT load your shell
# profile, so set them here (copy TESLA_VIN from your shell / the Tesla app).
TESLA_KEY_NAME=tesla
TESLA_VIN=
TESLA_CACHE_FILE=~/.tesla-cache.json
# If the car can't be read (asleep/out of range/BLE denied), charge anyway
# instead of holding. Set true only if BLE proves unreliable under the daemon.
CHARGE_IF_CAR_UNKNOWN=false

# --- Weather (Open-Meteo — no API key, no account, nothing to leak) ---
# Weather is optional decoration on top of the energy dashboard: if the internet
# is down the house still charges the car, and the screen simply drops it.
WEATHER_ENABLED=true
WEATHER_REFRESH_MINUTES=15
# Your array's rated size in kW, used to turn forecast irradiance into an
# estimated output. Normally leave this blank: it is worked out automatically
# from figures Solarman already publishes (lifetime generation divided by
# "full power hours" gives the rated capacity back). Set it only to override
# that, or if your provider doesn't report those totals.
# SOLAR_ARRAY_KWP=
# Note: your coordinates are rounded to 2 decimal places (~1km) before being sent
# to Open-Meteo. Its forecast grid is coarser than that, so nothing is lost.

# --- Scheduling (the `watch` daemon) ---
# How often to tick, as a cron expression. Default = :00 and :30 each hour.
# Examples:  every 15 min -> */15 * * * *   ·   hourly -> 0 * * * *   ·   every 5 min -> */5 * * * *
SCHEDULE_CRON=0,30 * * * *

# --- Dashboard (living-room tablet) ---
UI_PORT=8080
UI_HOST=0.0.0.0
# How often the display refreshes. Never wakes the car.
UI_REFRESH_S=15
# Don't re-poll Solarman more often than this; upstream only updates ~5-minutely.
SOLARMAN_MIN_INTERVAL_S=60
# Required for the manual controls (override, car refresh). Blank = controls off.
DASHBOARD_TOKEN=
# Home coordinates, used ONLY for sunrise/sunset so the scene matches the sky.
# City-level precision is plenty. Defaults to Melbourne CBD.
LATITUDE=-37.81
LONGITUDE=144.96

LOG_LEVEL=info
